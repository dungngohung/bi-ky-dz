---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const tips = await getCollection('tips');
  return tips.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} - Bí kỹ cá nhân của Dz`} description={entry.data.description}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs text-[#787774] dark:text-[#888888] mb-6">
    <a href="/" class="hover:underline flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Tất cả bí kỹ
    </a>
    <span>/</span>
    <span class="text-[#37352f] dark:text-gray-200">{entry.data.category}</span>
  </nav>

  <article>
    <!-- Header -->
    <header class="mb-8">
      <!-- Big Notion Emoji -->
      <div class="text-5xl md:text-6xl mb-4 select-none">
        {entry.data.emoji}
      </div>

      <h1 class="text-2xl md:text-4xl font-bold tracking-tight text-[#1a1a1a] dark:text-gray-50 mb-3 leading-snug">
        {entry.data.title}
      </h1>

      <p class="text-base text-[#666561] dark:text-[#a5a5a5] leading-relaxed mb-5">
        {entry.data.description}
      </p>

      <!-- Metadata chips -->
      <div class="flex flex-wrap items-center gap-3 py-3 border-y border-[#efefef] dark:border-[#2b2b2b] text-xs text-[#787774] dark:text-[#999999]">
        <div class="flex items-center gap-1.5 font-medium text-emerald-600 dark:text-emerald-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Đã thực chứng với bản thân
        </div>

        <span>•</span>
        <div>Cập nhật: {entry.data.updatedDate}</div>
        <span>•</span>
        <div>{entry.data.readTimeMinutes} phút đọc nhanh</div>
      </div>

      <!-- Quick Takeaway Box (Notion Highlight Callout) -->
      {entry.data.quickTakeaways && entry.data.quickTakeaways.length > 0 && (
        <div class="notion-callout bg-[#edf3ec] dark:bg-[#1a281e] border border-[#d3e5d0] dark:border-[#27422f] my-6">
          <span class="text-xl">⚡</span>
          <div class="flex-1">
            <h3 class="font-semibold text-sm text-[#27492c] dark:text-emerald-300 mb-1.5">
              Tóm tắt cốt lõi (Nhớ nhanh trước khi làm):
            </h3>
            <ul class="list-disc list-inside text-xs md:text-sm text-[#2e5334] dark:text-emerald-200/90 space-y-1">
              {entry.data.quickTakeaways.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </header>

    <!-- Main Content rendered from Markdown -->
    <div class="notion-prose">
      <Content />
    </div>

    <!-- Tags & Navigation footer -->
    <footer class="mt-12 pt-6 border-t border-[#efefef] dark:border-[#2b2b2b]">
      {entry.data.tags && (
        <div class="flex flex-wrap items-center gap-1.5 mb-6">
          <span class="text-xs text-[#888888] mr-1">Tags:</span>
          {entry.data.tags.map((tag) => (
            <span class="text-xs text-[#787774] dark:text-[#aaaaaa] bg-[#f7f6f3] dark:bg-[#252525] px-2.5 py-1 rounded">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <div class="flex justify-between items-center pt-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-medium px-4 py-2 rounded-lg bg-[#f7f6f3] dark:bg-[#252525] hover:bg-[#efede9] dark:hover:bg-[#303030] text-[#37352f] dark:text-gray-200 transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Về trang tìm kiếm
        </a>

        <button
          id="copy-link-btn"
          class="inline-flex items-center gap-1.5 text-xs text-[#787774] hover:text-[#37352f] dark:hover:text-white px-3 py-1.5 rounded border border-[#e5e5e5] dark:border-[#333333] transition"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-text">Sao chép link</span>
        </button>
      </div>
    </footer>
  </article>

  <script is:inline>
    const copyBtn = document.getElementById('copy-link-btn');
    const copyText = document.getElementById('copy-text');
    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
      if (copyText) {
        copyText.textContent = 'Đã chép link!';
        setTimeout(() => {
          copyText.textContent = 'Sao chép link';
        }, 2000);
      }
    });
  </script>
</Layout>
