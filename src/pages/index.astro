---
import Layout from '../layouts/Layout.astro';
import SearchAndList from '../components/SearchAndList.astro';
import { getCollection } from 'astro:content';

const allTips = await getCollection('tips');
// Sort by updatedDate descending
allTips.sort((a, b) => new Date(b.data.updatedDate).getTime() - new Date(a.data.updatedDate).getTime());
---

<Layout title="Bí kỹ cá nhân của Dz - Cẩm nang thực chiến đúc kết từ AI">
  <!-- Notion Style Page Header -->
  <header class="mb-10">
    <div class="text-5xl md:text-6xl mb-4 select-none">
      📓
    </div>
    
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[#222222] dark:text-gray-50 mb-3">
      Bí kỹ cá nhân của Dz
    </h1>
    
    <p class="text-base md:text-lg text-[#666561] dark:text-[#a0a0a0] leading-relaxed max-w-2xl">
      Cẩm nang tổng hợp các mẹo đời sống, nhà bếp và sức khỏe hữu ích. Tinh gọn từ các trao đổi sâu với AI và đã được kiểm chứng hiệu quả trong thực tế.
    </p>

    <!-- Notion-style callout hint -->
    <div class="notion-callout bg-[#f7f6f3] dark:bg-[#222222] border border-[#e9e9e7] dark:border-[#333333] mt-5">
      <span class="text-xl">💡</span>
      <div class="text-xs md:text-sm text-[#555] dark:text-[#bbb]">
        <strong>Mẹo tra cứu nhanh:</strong> Nhấn phím <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#333] border border-[#ddd] dark:border-[#444] text-[11px] font-mono">/</kbd> để nhảy ngay vào ô tìm kiếm. Gõ tên món, loại rau hoặc vấn đề cần xử lý để xem hướng dẫn ngay lập tức!
      </div>
    </div>
  </header>

  <!-- Interactive Search & Content List -->
  <SearchAndList tips={allTips} />
</Layout>
